# Environment Variables (DO NOT COMMIT TOKENS!)
# Copy this file to .env and fill in your actual values

# Discord Bot Token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Default Discord Server ID (optional)
# When provided, guildId parameter becomes optional for tools
DISCORD_GUILD_ID=your_default_guild_id_here

# Directory file.upload may read local files from (optional).
# Unset: uploading local files is refused. Only files inside this directory can be uploaded.
# DISCORD_MCP_UPLOAD_DIR=/path/to/uploads

# Logging Configuration
# INFO/DEBUG logs go to stdout and break the stdio transport; keep WARN or lower for stdio.
ENABLE_LOGGING=false
LOG_LEVEL=WARN

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1000
TIMEOUT=30000

# Rate Limit Protection
RATE_LIMIT_PROTECTION=true

# Action Permissions (comma-separated, leave empty for all actions)
# ALLOWED_ACTIONS=get_server_info,send_message,read_messages
# DENIED_ACTIONS=delete_channel,ban_member

# Server Mode: hybrid (default) | codemode | legacy
# DISCORD_MCP_MODE=hybrid

# Code Mode policy (only used when DISCORD_MCP_MODE=codemode)
# NOTE: ALLOWED_ACTIONS / DENIED_ACTIONS above do NOT affect Code Mode.
# Patterns match OpenAPI operationIds and may use * (comma-separated).
# Only GET requests are allowed (default true; set false to allow writes)
# CODEMODE_READ_ONLY=true
# Allowlist; when set, everything else is denied
# CODEMODE_ALLOW=list_*,get_*,create_message
# Denylist; always wins over CODEMODE_ALLOW
# CODEMODE_DENY=ban_user_from_guild,delete_*
# Only these server IDs may be touched (comma-separated)
# CODEMODE_SCOPE_GUILDS=123456789012345678
# Channel writes limited to channels under these category IDs
# CODEMODE_SCOPE_CATEGORIES=123456789012345678
# Allow requests that grant Administrator / Manage Server / Manage Roles / Manage Webhooks
# CODEMODE_ALLOW_DANGEROUS_PERMS=false
